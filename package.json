{
  "name": "dark-and-darker-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "fixtures:validate": "node --import tsx tools/validate-fixtures.ts",
    "localization:sync": "node --import tsx tools/sync-localization.ts",
    "gameplay:sync": "node --import tsx tools/sync-gameplay-catalog.ts",
    "gameplay:import-dndtools": "node --import tsx tools/import-dndtools-gameplay-catalog.ts",
    "darkerdb:samples": "node --import tsx tools/capture-darkerdb-live-samples.ts",
    "protocol:replay": "node --import tsx tools/replay-protocol-fixture.ts",
    "protocol:analyze-move002": "node --import tsx tools/analyze-private-move002.ts",
    "nav001:operator": "node --import tsx tools/nav001-private-operator.ts",
    "move003:prepare-refresh": "node --import tsx tools/nav001-private-operator.ts --mode prepare-move003-refresh --directory fixtures-private/runtime/move-003-refresh",
    "move003:prepare-plan": "node --import tsx tools/prepare-private-move003-plan.ts",
    "move003:calibrate": "node --import tsx tools/calibrate-private-stash-grid.ts",
    "sort:calibrate": "node --import tsx tools/calibrate-private-stash-grid.ts --include-bag true",
    "move003:run": "node --import tsx tools/run-private-supervised-move.ts",
    "operator": "node --import tsx tools/local-operator-server.ts",
    "protocol:audit-cross-capture": "node --import tsx tools/audit-private-cross-capture.ts",
    "protocol:schema": "node --import tsx tools/generate-protocol-schema.ts",
    "protocol:replay-net000": "node --import tsx tools/replay-private-net000.ts",
    "protocol:powershell-test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/tests/record-game-traffic.tests.ps1",
    "check": "npm run typecheck && npm run fixtures:validate && npm run test && npm run build"
  },
  "dependencies": {
    "i18next": "^25.0.0",
    "protobufjs": "^7.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
